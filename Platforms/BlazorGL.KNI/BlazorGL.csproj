<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GameProject</RootNamespace>
    <AssemblyName>LookingForGroup</AssemblyName>
    <DefineConstants>$(DefineConstants);KNI;BLAZORGL</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- The game formats nothing by culture, so the icu*.dat files can go. itch.io serves
         `.dat` with no compression at all. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Nothing reads the `.br` and `.gz` copies, and itch.io compresses on the way out
         anyway. They would only double the size of the push. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.3.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.3.9001" />

    <PackageReference Include="Apos.Camera.KNI" Version="0.5.1" />
    <PackageReference Include="Apos.Input.KNI" Version="3.2.0" />
    <PackageReference Include="Apos.Shapes.KNI" Version="0.9.4" />
    <PackageReference Include="Apos.Spatial.KNI" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Pages/Index.razor.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Game/**/*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <KniContentReference Include="../../Content/**/*.mgcb">
      <Link>Content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </KniContentReference>
  </ItemGroup>

</Project>
